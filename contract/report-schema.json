{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JMHScript-Validator report",
  "description": "Versioned JSON report (reportVersion 1). Consumers assert reportVersion and map codes; validatorVersion is informational.",
  "type": "object",
  "required": ["reportVersion", "validatorVersion", "registry", "files", "summary"],
  "properties": {
    "reportVersion": {"type": "integer", "const": 1},
    "validatorVersion": {"type": "string"},
    "registry": {
      "type": "object",
      "required": ["engine", "engineVersion"],
      "properties": {
        "engine": {"type": "string"},
        "engineVersion": {"type": "string"}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "diagnostics"],
        "properties": {
          "file": {"type": "string"},
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["behavior", "list", "line", "char", "severity", "code", "message"],
              "properties": {
                "behavior": {"type": "string"},
                "list": {"type": "string"},
                "line": {"type": "integer"},
                "char": {"type": ["integer", "null"]},
                "severity": {"type": "string", "enum": ["error", "warning"]},
                "code": {
                  "type": "string",
                  "enum": ["E_BRACKET_UNMATCHED_CLOSE", "E_BRACKET_UNCLOSED_OPEN", "E_SYNTAX", "E_UNKNOWN_ROOT", "E_UNKNOWN_ITEM", "W_UNKNOWN_TAG", "W_RANDOM_PICK_ITEM", "W_ALL_PLAYERS_FILTER", "W_UNKNOWN_MODIFIER", "W_DUPLICATE_ID", "W_DUPLICATE_SETTING", "W_UNKNOWN_SETTING", "W_UNKNOWN_TRIGGER", "W_UNKNOWN_KEY", "W_UNKNOWN_SETTING_TYPE", "W_DEFAULT_OUTSIDE_ALLOWED", "E_FILE_READ", "E_YAML_PARSE", "E_YAML_SHAPE", "E_YAML_LINE_TYPE", "W_SETTINGS_FOLDERS", "W_SETTINGS_STRAY_LEAF", "W_SETTINGS_LEAFS"]
                },
                "message": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["files", "errors", "warnings"],
      "properties": {
        "files": {"type": "integer"},
        "errors": {"type": "integer"},
        "warnings": {"type": "integer"}
      }
    }
  }
}
